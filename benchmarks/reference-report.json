          "claim_1": {
            "type": "claim",
            "lang": "en",
            "text": "Ada is the only child of the marriage of poet George Gordon Byron and philanthropist Annabella Milbanke, cousin of Caroline Lamb, whose affair with Byron caused a scandal.",
